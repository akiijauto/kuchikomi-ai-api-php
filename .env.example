# .env.example
# 本物の値は書かない。すべてプレースホルダ。開発時はこれをコピーして .env を作り、
# 実際の値を入れる（.env はコミットしない）。

# PostgreSQL接続文字列。テーブル定義の正本は元リポジトリ(kuchikomi-ai-multi-stack)。
# 例: postgresql://user:pass@host:5432/db
DATABASE_URL=postgresql://user:password@localhost:5432/kuchikomi

# トークンの検証鍵。ログイン基盤が発行するJWTをこの鍵で検証する。
# 本物の値は環境ごとのシークレット管理に置き、ここには絶対に書かない
# HS256 には32バイト以上が必要（短いと起動時に落ちる）。
# 生成例: openssl rand -hex 24
JWT_SECRET=change-me-0000000000000000000000000000000

# 待ち受けポート。未設定時のアプリ既定値はソース(src/public/index.php)を参照
PORT=3000

# 1のときだけ、デモ用トークン発行エンドポイント(/api/demo/token)が有効になる
DEMO_MODE=1

# Anthropic APIキー。未設定なら返信生成はモック(mock: true)を返す想定
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 使用するモデル。Go版・Rails版と同じ既定値に揃えてある
ANTHROPIC_MODEL=claude-sonnet-4-6
